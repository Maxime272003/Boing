{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boing",
  "version": "0.1.0",
  "identifier": "app.boing.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Boing",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Trouver un travail plus vite",
    "windows": {
      "nsis": { "languages": ["French"], "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4QzQ2RTRGQTk4QzEwODYKUldTR0VJeXBUMjdFU05QY0lpUDJOSlZGOFoySUtBR2JPZkErYm5ieERBdXFCVklONkJ0N0U4QUcK",
      "endpoints": ["https://github.com/Maxime272003/Boing/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
